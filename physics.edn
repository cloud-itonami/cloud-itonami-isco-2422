;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a document-handling robot performs physical
;; filing, archive retrieval and document scanning (ISCO 2422, policy
;; administration professionals). Its physical work: retrieving a policy
;; archive box from the top shelf of the stacks down to the scanning desk,
;; and moving the retrieved boxes between the stacks and the scan room.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-2422"
 :cases
 [{:id :archive-box-from-top-shelf
   :kind :manipulator
   :procedure "arm retrieves a policy archive box from the top shelf and lowers it to the scanning desk"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.0
            :from [0.30 0.90] :to [0.65 0.05] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [3.0 6.0 9.0 12.0 15.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: continuous shoulder torque of a 10 kg-payload class collaborative arm"}
   :boundary {:lo 0.5 :hi 60.0}}
  {:id :stacks-to-scan-room
   :kind :transport
   :procedure "AMR carries retrieved archive boxes from the stacks to the scan room"
   :params {:mass-kg 45.0 :payload-kg 40.0 :v-max-mps 0.9 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 90.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.25}
   :sweep {:param :distance-m :values [20.0 40.0 60.0 80.0 100.0]}
   :quantity :cycle-time-s
   :limit {:max 80.0 :basis "estimate: a retrieval leg within 80 s keeps a same-hour turnaround for records requests"}
   :boundary {:lo 5.0 :hi 250.0}}]}
